PORT=5000
AI_SERVICE_URL=http://localhost:8000
QUESTION_DATA_DIR=../../data/local
LOCAL_TEACHER_ID=local-teacher
# Gemini memakai endpoint OpenAI-compatible. Salin file ini menjadi .env lalu
# isi GEMINI_API_KEY sendiri; jangan commit atau kirim key melalui chat.
LLM_PROVIDER=gemini
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=
LLM_SCREEN_MODEL=gemini-3.8-flash
LLM_SOLVER_MODEL=gemini-3.8-flash
LLM_ADJUDICATOR_MODEL=gemini-3.8-flash
LLM_SAMPLE_COUNT=3
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_MS=45000
# Evaluator smoke memakai default 31000 ms agar aman pada kuota rendah.
# Untuk workflow normal, sesuaikan dengan batas RPM aktif di Google AI Studio.
LLM_MIN_REQUEST_INTERVAL_MS=0
LLM_MAX_ATTEMPTS=4
LLM_RETRY_BASE_MS=1000
# Memberi waktu rolling quota pulih bila smoke test dijalankan setelah health check.
LLM_SMOKE_INITIAL_COOLDOWN_MS=65000
