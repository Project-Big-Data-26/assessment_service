APP_ENV=development
MODEL_CACHE_DIR=models/cache

# LLM provider (copy this file to .env, then put the real key only in .env).
LLM_PROVIDER=gemini
GEMINI_API_KEY=replace-with-your-private-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
# Normally this endpoint does not need to be changed when using Google's SDK.
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
# Safe default: no paid generation until an operator enables it explicitly.
GEMINI_LIVE_ENABLED=false
GEMINI_REVIEW_RUNS=3
GEMINI_TIMEOUT_SECONDS=45
GEMINI_MAX_OUTPUT_TOKENS=1200
GEMINI_TEMPERATURE=0.2

# Never commit the real URI. Atlas requires a least-privilege application user.
MONGODB_URI=mongodb+srv://application-user:replace-me@example.mongodb.net/
MONGODB_DATABASE=nalar_research
AI_SERVICE_URL=http://127.0.0.1:8000

# v2 runtime: one CPU worker, checksum-verified offline artifact.
INDOBERT_V2_ARTIFACT_DIR=models/indobert-3x4x3-v1
WEB_CONCURRENCY=1
SESSION_SECRET=replace-with-at-least-32-random-bytes
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_ORIGINS=http://localhost:8000

# Local fixed-form pilot + empirical CTT/IRT. Real .env stays private.
ASSESSMENT_DB_PATH=data/local/assessments.sqlite3
PSYCHOMETRICS_POLICY_PATH=configs/psychometrics_policy.json
# Internal analysis/participant provisioning; generate a random token >=32 chars.
PSYCHOMETRICS_API_TOKEN=
# Optional stable HMAC key. If omitted, the local store persists a random key.
ASSESSMENT_SUBJECT_SECRET=

# Private S3-compatible source assets. The bucket must not be public.
S3_ENDPOINT_URL=https://replace-me.example
S3_BUCKET=nalar-private-source-assets
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_SIGNED_URL_TTL_SECONDS=300
