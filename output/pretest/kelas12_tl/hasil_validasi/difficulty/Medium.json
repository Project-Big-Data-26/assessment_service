        "options": [
          {
            "label": "A",
            "text": "$p=1$ atau $p=3$"
          },
          {
            "label": "B",
            "text": "$p=1$ atau $p=5$"
          },
          {
            "label": "C",
            "text": "$p=-1$ atau $p=-5$"
          },
          {
            "label": "D",
            "text": "$p=3$"
          }
        ],
        "visualAssets": [],
        "visualAssetHashes": {},
        "visualTranscript": null,
        "verifiedMinimalSolution": "Lingkaran x^2+y^2-2x-4y+3=0 memiliki pusat (1,2) dan r^2=2. Jarak pusat ke garis x+y-p=0 adalah |1+2-p|/sqrt(2) = sqrt(2). Maka |3-p|=2, sehingga p=1 atau p=5.",
        "verificationProvenance": "llm_silver_not_expert_verified",
        "detectedKko": [
          "mengidentifikasi"
        ],
        "privateAnswerSpecification": {
          "answerKey": "B",
          "verifiedAnswerKey": "p=1 atau p=5",
          "answerKeyStatus": "verified",
          "visibility": "restricted"
        },
        "source": {
          "externalId": "09343175fbd7eabe7e201500",
          "subchapter": "Kedudukan Titik dan Garis terhadap Lingkaran",
          "assetBasePath": "D:/KULIAH/Big Data/extraction_model/output/pretest/kelas12_tl",
