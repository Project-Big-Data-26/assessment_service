        "contentHash": "6dfaff95794ce756192ea1a95733ec26a636dd15c90803297b4fe5d3daf25776",
        "grade": 12,
        "topic": "Matematika Tingkat Lanjut SMA Kelas 12",
        "subtopic": "Penerapan Integral",
        "questionType": "multiple_choice",
        "stem": "Tentukan luas daerah yang dibatasi oleh kurva $y^2=2x-2$ dan $y=x-5$.",
        "stimulus": null,
        "options": [
          {
            "label": "A",
            "text": "$12$ satuan luas"
          },
          {
            "label": "B",
            "text": "$18$ satuan luas"
          },
          {
            "label": "C",
            "text": "$36$ satuan luas"
          },
          {
            "label": "D",
            "text": "$9$ satuan luas"
          }
        ],
        "visualAssets": [],
        "visualAssetHashes": {},
        "visualTranscript": null,
        "verifiedMinimalSolution": "Ubah kurva ke fungsi y: x = y^2/2 + 1 dan x = y + 5. Titik potong: y^2/2 + 1 = y + 5 => y^2 - 2y - 8 = 0 => (y-4)(y+2)=0. Batas y: -2 sampai 4. Luas = integral dari -2 sampai 4 dari ((y+5) - (y^2/2 + 1)) dy = integral dari -2 sampai 4 dari (-y^2/2 + y + 4) dy = [-y^3/6 + y^2/2 + 4y] dari -2 sampai 4 = (-64/6 + 16/2 + 16) - (8/6 + 4/2 - 8) = (-32/3 + 24) - (4/3 - 6) = 40/3 - (-14/3) = 54/3 = 18.",
        "verificationProvenance": "llm_silver_not_expert_verified",
        "detectedKko": [
          "mengidentifikasi"
        ],
        "privateAnswerSpecification": {
          "answerKey": "B",
          "verifiedAnswerKey": "18",
          "answerKeyStatus": "verified",
          "visibility": "restricted"
        },
        "source": {
          "externalId": "f064d8080e4b3fccc44ce182",
          "subchapter": "Penerapan Integral",
          "assetBasePath": "D:/KULIAH/Big Data/extraction_model/output/pretest/kelas12_tl",
          "optionExtractionNotes": {
            "A": "Salah: suku $y$ hilang saat mengintegralkan selisih",
            "B": "Benar: titik potong $(3,-2)$ dan $(9,4)$; $L=\\int_{-2}^{4}\\left[(y+5)-\\left(\\frac{y^2}{2}+1\\right)\\right]dy=18$",
            "C": "Salah: menghitung dua kali karena dua cabang parabola",
            "D": "Salah: hasil dibagi dua"
          }
        }
      },
