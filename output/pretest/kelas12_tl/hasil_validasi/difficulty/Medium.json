        "options": [
          {
            "label": "A",
            "text": "Panjang $20$ cm dan lebar $5$ cm"
          },
          {
            "label": "B",
            "text": "Panjang $7,5$ cm dan lebar $15$ cm"
          },
          {
            "label": "C",
            "text": "Panjang $10$ cm dan lebar $10$ cm"
          },
          {
            "label": "D",
            "text": "Panjang $15$ cm dan lebar $7,5$ cm"
          }
        ],
        "visualAssets": [],
        "visualAssetHashes": {},
        "visualTranscript": null,
        "verifiedMinimalSolution": "Misal x adalah tinggi lipatan (lebar sisi), maka lebar alas = 30-2x. Luas penampang L(x) = x(30-2x) = 30x - 2x^2. Maksimum saat L'(x) = 30 - 4x = 0, sehingga x = 7,5 cm. Lebar alas = 30 - 2(7,5) = 15 cm. Ukuran: tinggi 7,5 cm, lebar 15 cm.",
        "verificationProvenance": "llm_silver_not_expert_verified",
        "detectedKko": [
          "mengidentifikasi"
        ],
        "privateAnswerSpecification": {
          "answerKey": "D",
          "verifiedAnswerKey": "D",
          "answerKeyStatus": "verified",
          "visibility": "restricted"
        },
        "source": {
          "externalId": "1a7617d4eabc8a84d287b87c",
          "subchapter": "Aplikasi Turunan Fungsi di Berbagai Bidang Ilmu",
          "assetBasePath": "D:/KULIAH/Big Data/extraction_model/output/pretest/kelas12_tl",
          "optionExtractionNotes": {
            "A": "Salah: salah menurunkan L(x)=30x-2x^2, memperoleh x=5 bukan 7,5",
            "B": "Salah: tertukar antara ukuran panjang (30-2x) dan lebar (x)",
            "C": "Salah: mengira penampang optimal selalu berbentuk persegi sama sisi",
            "D": "Benar: $L(x)=(30-2x)x=30x-2x^2$, $L'(x)=30-4x=0\\Rightarrow x=7,5$; panjang $=30-2(7,5)=15$"
