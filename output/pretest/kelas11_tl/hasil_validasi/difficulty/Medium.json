        "verificationProvenance": "ai_silver",
        "detectedKko": [],
        "privateAnswerSpecification": {
          "answerKey": "A",
          "verifiedAnswerKey": "A",
          "answerKeyStatus": "verified",
          "visibility": "restricted"
        },
