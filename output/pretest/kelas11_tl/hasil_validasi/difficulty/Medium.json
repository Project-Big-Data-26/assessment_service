        "questionType": "multiple_choice",
        "stem": "Perahu layar. Sebuah perahu layar bergerak sejauh 100 m ke utara, sedangkan angin memberi gaya 500 N ke timur laut. Berapa banyak usaha yang dilakukan angin?",
        "stimulus": null,
        "options": [
          {
            "label": "A",
            "text": "$25.000\\sqrt{3}$ J"
          },
          {
            "label": "B",
            "text": "$0$ J"
          },
          {
            "label": "C",
            "text": "$50.000$ J"
          },
          {
            "label": "D",
            "text": "$25.000\\sqrt{2}$ J"
          }
        ],
        "visualAssets": [],
        "visualAssetHashes": {},
        "visualTranscript": null,
        "verifiedMinimalSolution": "Usaha (W) adalah hasil kali titik antara vektor gaya (F) dan vektor perpindahan (d), yaitu W = |F||d|cos(θ). Arah utara dan timur laut membentuk sudut θ = 45°. Maka, W = 500 N * 100 m * cos(45°) = 50.000 * (1/2 √2) = 25.000√2 J.",
        "verificationProvenance": "ai_silver",
        "detectedKko": [
          "menghitung"
        ],
        "privateAnswerSpecification": {
          "answerKey": "D",
          "verifiedAnswerKey": "D",
          "answerKeyStatus": "verified",
          "visibility": "restricted"
        },
        "source": {
          "externalId": "a6cd9d3eef6dcf642995a65e",
          "subchapter": "Hasil Kali Titik",
          "assetBasePath": "D:/KULIAH/Big Data/extraction_model/output/pretest/kelas11_tl",
          "optionExtractionNotes": {
            "A": "Salah: memakai cos 30° (½√3) bukan cos 45° (½√2)",
            "B": "Salah: keliru menganggap arah timur laut tegak lurus dengan utara sehingga usahanya nol",
            "C": "Salah: mengalikan langsung 500 N × 100 m tanpa memperhitungkan sudut 45° antara arah gaya dan arah gerak",
            "D": "Benar: sudut antara arah utara (gerak) dan timur laut (gaya) adalah 45°, sehingga W = |F||d|cos 45° = 500·100·(1/2 √2) = 25.000√2 J"
          }
        }
      },
