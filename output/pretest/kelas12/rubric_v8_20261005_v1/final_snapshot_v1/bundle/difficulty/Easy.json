        "visualAssets": [],
        "visualAssetHashes": {},
        "visualTranscript": null,
        "verifiedMinimalSolution": "Bunga tahunan tetap = 5% x 1.000.000 = 50.000. Saldo akhir tahun ke-2 = Saldo akhir tahun ke-1 + bunga tahun ke-2 = 1.050.000 + 50.000 = 1.100.000.",
