        "subtopic": "Deret",
        "questionType": "multiple_choice",
        "stem": "Suatu deret geometri memiliki suku pertama a = 5 dan rasio r = 2. Hitunglah jumlah 6 suku pertama deret tersebut.",
        "stimulus": null,
        "options": [
          {
            "label": "A",
            "text": "635"
          },
          {
            "label": "B",
            "text": "315"
          },
          {
            "label": "C",
            "text": "310"
          },
          {
            "label": "D",
            "text": "320"
          }
        ],
        "visualAssets": [],
        "visualAssetHashes": {},
        "visualTranscript": null,
        "verifiedMinimalSolution": "S_n = a(r^n - 1) / (r - 1). S_6 = 5(2^6 - 1) / (2 - 1) = 5(64 - 1) = 5 * 63 = 315.",
        "verificationProvenance": "ai_silver",
        "detectedKko": [
          "menghitung"
        ],
        "privateAnswerSpecification": {
          "answerKey": "B",
          "verifiedAnswerKey": "B",
          "answerKeyStatus": "verified",
          "visibility": "restricted"
        },
        "source": {
          "externalId": "6e5ddb2020e2a12b1ecf2b03",
          "subchapter": "Deret",
          "assetBasePath": "D:/KULIAH/Big Data/extraction_model/output/pretest/kelas12",
          "optionExtractionNotes": {
            "A": "Salah: memakai rumus Sn = a·r^n - a tanpa dibagi (r-1)",
            "B": "Benar: Sn=a(r^n-1)/(r-1); S6=5(2^6-1)/(2-1)=5(63)=315",
            "C": "Salah: salah menghitung 2^6 (memakai 63 dari 2^6-1 tapi lupa dikali 5 dengan benar, hasil dibulatkan keliru)",
            "D": "Salah: salah menghitung 2^6 sebagai 64 lalu langsung dikali 5 tanpa mengurangi 1 (5x64=320)"
          }
        }
      },
