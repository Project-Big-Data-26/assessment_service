        "options": [
          {
            "label": "A",
            "text": "Rp104.166,67"
          },
          {
            "label": "B",
            "text": "Rp112.500,00"
          },
          {
            "label": "C",
            "text": "Rp108.333,33"
          },
          {
            "label": "D",
            "text": "Rp225.000,00"
          }
        ],
        "visualAssets": [],
        "visualAssetHashes": {},
        "visualTranscript": null,
        "verifiedMinimalSolution": "Bunga total = M x p x t = 2.500.000 x 0,04 x 2 = 200.000. Total pengembalian = 2.500.000 + 200.000 = 2.700.000. Cicilan per bulan = 2.700.000 / 24 = 112.500.",
